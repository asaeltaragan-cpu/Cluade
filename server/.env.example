# Copy to .env and fill in your Supabase project's values.
# SUPABASE_SERVICE_ROLE_KEY is highly privileged — never expose it to the
# browser, never commit .env, and only use it inside this server.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Origin of the Vite dev/prod app, for CORS
WEB_ORIGIN=http://localhost:5173

PORT=8787

# Optional: Airtable sync. Omit AIRTABLE_TOKEN to leave the feature disabled
# (the sync/status endpoints will error, and no automatic sync will run).
# Use a Personal Access Token scoped only to the base below.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appfu5RQfIfOJeT27
AIRTABLE_CUSTOMERS_TABLE_ID=tblPPp6Op7OADlw2d
AIRTABLE_SALES_TABLE_ID=tblv5NwxOib3zAUm3

# Shared secret for the external cron trigger (.github/workflows/airtable-sync.yml).
# Generate any long random string; keep it identical here and in the GitHub secret CRON_SECRET.
CRON_SECRET=

