# Copy to .env and fill in your Supabase project's values.
# SUPABASE_SERVICE_ROLE_KEY is highly privileged — never expose it to the
# browser, never commit .env, and only use it inside this server.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Origin of the Vite dev/prod app, for CORS
WEB_ORIGIN=http://localhost:5173

PORT=8787
